# The browser app listens only on this computer by default.
RAISE_HOST=127.0.0.1
RAISE_PORT=8765
RAISE_DATA_DIR=./data
RAISE_MAX_UPLOAD_MB=30

# Pick any configured provider in the app. Keys stay in this local file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vertex AI uses Application Default Credentials, not an API key.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.8-flash

# Paste the exact Claude model ID shown as enabled in Model Garden.
# Availability and regions depend on the organization's Model Garden policy.
VERTEX_CLAUDE_MODEL=claude-opus-4-8
VERTEX_CLAUDE_LOCATION=global

# Generation controls.
RAISE_MAX_OUTPUT_TOKENS=100000
RAISE_RETRIEVAL_LIMIT=12

